<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A remote is enough: no touchscreen needed, and phones can install it too. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- Controllers are optional: the app still installs on TVs without one. -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets "Update TV app" hand the new APK to the system installer. Android still asks. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Nearby chat (Bitchat-compatible Bluetooth mesh). Optional; asked for only
         when the user presses Allow on that screen. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Optional home screen (launcher/HomeActivity): the TV apps it lists and
             the system screens its top bar opens. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.search.action.GLOBAL_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.ASSIST" />
        </intent>
        <intent>
            <action android:name="android.speech.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="com.android.tv.action.VIEW_INPUTS" />
        </intent>
        <intent>
            <action android:name="android.settings.TV_INPUT_SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".TvApp"
        android:allowBackup="true"
        android:banner="${appBanner}"
        android:icon="${appIcon}"
        android:label="${launcherName}"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Translucent.NoTitleBar">

        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />

        <!-- The real launcher. Its home-screen entries are the aliases below, so the
             name and icon can be switched at runtime (Settings > TV app name). -->
        <activity
            android:name=".TvLauncherActivity"
            android:exported="true">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="${defaultUrl}" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR" android:value="${themeColor}" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR" android:value="${themeColor}" />
            <meta-data android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY" android:value="webview" />
            <meta-data android:name="android.support.customtabs.trusted.DISPLAY_MODE" android:value="immersive" />
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${hostName}" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".LauncherDefault"
            android:targetActivity=".TvLauncherActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="${appIcon}"
            android:banner="${appBanner}"
            android:label="${launcherName}">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="${defaultUrl}" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR" android:value="${themeColor}" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR" android:value="${themeColor}" />
            <meta-data android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY" android:value="webview" />
            <meta-data android:name="android.support.customtabs.trusted.DISPLAY_MODE" android:value="immersive" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherMedia"
            android:targetActivity=".TvLauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_media"
            android:banner="@drawable/banner_media"
            android:label="@string/name_media">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="${defaultUrl}" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR" android:value="${themeColor}" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR" android:value="${themeColor}" />
            <meta-data android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY" android:value="webview" />
            <meta-data android:name="android.support.customtabs.trusted.DISPLAY_MODE" android:value="immersive" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherBrowser"
            android:targetActivity=".TvLauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_browser"
            android:banner="@drawable/banner_browser"
            android:label="@string/name_browser">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="${defaultUrl}" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR" android:value="${themeColor}" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR" android:value="${themeColor}" />
            <meta-data android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY" android:value="webview" />
            <meta-data android:name="android.support.customtabs.trusted.DISPLAY_MODE" android:value="immersive" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherPlayer"
            android:targetActivity=".TvLauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_player"
            android:banner="@drawable/banner_player"
            android:label="@string/name_player">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="${defaultUrl}" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR" android:value="${themeColor}" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR" android:value="${themeColor}" />
            <meta-data android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY" android:value="webview" />
            <meta-data android:name="android.support.customtabs.trusted.DISPLAY_MODE" android:value="immersive" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherNotes"
            android:targetActivity=".TvLauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_notes"
            android:banner="@drawable/banner_notes"
            android:label="@string/name_notes">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="${defaultUrl}" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR" android:value="${themeColor}" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR" android:value="${themeColor}" />
            <meta-data android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY" android:value="webview" />
            <meta-data android:name="android.support.customtabs.trusted.DISPLAY_MODE" android:value="immersive" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- viktorychtv://name?preset=media&title=... from the site picks a home-screen name. -->
        <receiver android:name=".Replaced" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".NameActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="viktorychtv" android:host="name" />
            </intent-filter>
        </activity>

        <!-- Used when the TV has no Chrome. Has the name bridge and one-press updates. -->
        <activity
            android:name=".TvWebActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|screenLayout|smallestScreenSize"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- viktorychtv://game/regone: ReGone with a controller, always in our own WebView
             so the controller can be turned into keys and touches. -->
        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:label="ReGone"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="viktorychtv" android:host="game" />
            </intent-filter>
        </activity>

        <!-- viktorychtv://mesh: nearby chat, offered by the site only when loading fails. -->
        <activity
            android:name=".MeshActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|screenLayout|smallestScreenSize"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="viktorychtv" android:host="mesh" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.google.androidbrowserhelper.trusted.WebViewFallbackActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Optional home screen ("Make ViktorychTV your default"). Off in the
             manifest, so the TV never offers it and nothing changes until the user
             turns it on from DefaultsActivity and confirms Android's own picker.
             It never replaces TvLauncherActivity, which stays the app's entry. -->
        <activity
            android:name=".launcher.HomeActivity"
            android:enabled="false"
            android:exported="true"
            android:label="${launcherName}"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|screenLayout|smallestScreenSize|locale|layoutDirection|uiMode"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- viktorychtv://defaults: one row per TV job with a Set button. -->
        <activity
            android:name=".launcher.DefaultsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|screenLayout|smallestScreenSize"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="viktorychtv" android:host="defaults" />
            </intent-filter>
        </activity>

        <!-- Optional player and screensaver (player/). Both are off in the manifest:
             no link opens differently and the TV lists no new screensaver until
             the user turns them on in DefaultsActivity, and Android still asks. -->
        <activity
            android:name=".player.PlayerActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/player_label"
            android:excludeFromRecents="true"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|screenLayout|smallestScreenSize|uiMode"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="music.youtube.com" />
                <data android:path="/watch" />
                <data android:pathPrefix="/shorts/" />
                <data android:pathPrefix="/live/" />
                <data android:pathPrefix="/embed/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="youtu.be" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="x.com" />
                <data android:host="www.x.com" />
                <data android:host="mobile.x.com" />
                <data android:host="twitter.com" />
                <data android:host="www.twitter.com" />
                <data android:host="mobile.twitter.com" />
                <data android:pathPattern="/.*/status/.*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="twitch.tv" />
                <data android:host="www.twitch.tv" />
                <data android:host="m.twitch.tv" />
                <data android:pathPattern="/..*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
                <data android:mimeType="application/x-mpegURL" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.FeedDream"
            android:enabled="false"
            android:exported="true"
            android:label="@string/dream_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- viktorychtv://dream?d=...: photos from the user's own feed for the screensaver. -->
        <activity
            android:name=".player.DreamFeedActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="viktorychtv" android:host="dream" />
            </intent-filter>
        </activity>

    </application>
</manifest>
