    <string name="def_title">Make ViktorychTV your default</string>
    <string name="def_sub">Each one is optional. Until you set one, your TV works as it does now and ViktorychTV opens as a normal app.</string>
    <string name="def_home">Home screen</string>
    <string name="def_home_desc">Your apps in big tiles with folders, and a top bar with search, inputs and settings. The ViktorychTV app stays one click away and opens just like now. Press Home on the remote to come back.</string>
