    <string name="def_title">ViktorychTV को डिफ़ॉल्ट बनाएं</string>
    <string name="def_sub">हर विकल्प वैकल्पिक है। जब तक आप कुछ नहीं चुनते, आपका टीवी अभी की तरह चलता है और ViktorychTV सामान्य ऐप की तरह खुलता है।</string>
    <string name="def_home">होम स्क्रीन</string>
    <string name="def_home_desc">आपके ऐप बड़ी टाइलों और फ़ोल्डरों में, और ऊपर खोज, इनपुट और सेटिंग वाली बार। ViktorychTV ऐप एक क्लिक पर रहता है और अभी की तरह ही खुलता है। लौटने के लिए रिमोट पर होम दबाएं।</string>
